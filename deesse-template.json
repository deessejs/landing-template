{
  "$schema": "https://app.deessejs.com/schema/template/v1.json",
  "formatVersion": 1,
  "name": "landing-template",
  "title": "Landing Starter",
  "description": "Landing page starter for SaaS and product marketing sites.",
  "version": "1.0.0",
  "type": "template:landing",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "category": "marketing",
  "labels": [
    "landing",
    "marketing",
    "nextjs"
  ],
  "source": {
    "repo": "deessejs/landing-template"
  },
  "includes": [
    "**/*"
  ],
  "excludes": [
    "deesse-template.json",
    ".changeset/**",
    ".claude/**",
    ".codex/**",
