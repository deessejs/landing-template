    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    ".env",
    "**/.env",
    ".env.local",
    "**/.env.local",
    ".env.*.local",
    "**/.env.*.local",
    ".env.development",
